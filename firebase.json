{
  "firestore": [
    {
      "database": "ai-studio-android-property-927de2c4-bc76-4f59-b4aa-99e514cdbdd6",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "admin-web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
